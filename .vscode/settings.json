{
    "clangd.arguments": [
        "--compile-commands-dir=build",
        "--query-driver=/nix/store/*/bin/clang++",
        "--query-driver=/nix/store/*/bin/clang",
    ],
    "editor.rulers": [
        100
    ],
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    }
}