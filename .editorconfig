root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

indent_style = space
indent_size = 4
tab_width = 4

max_line_length = 100

[*.{cpp,c,hpp,h,inl,cc,cxx,hxx,ixx}]
indent_style = space
indent_size = 4

[*.cmake]
indent_size = 4

[CMakeLists.txt]
indent_size = 4

[*.nix]
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.json]
indent_size = 4
